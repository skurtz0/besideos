# Cloudflare Pages: these files keep the same name from one release to the next, so browsers must check for a new
# version every time instead of showing a cached copy for hours (a stale main.dart.js would mix with newer assets).
/main.dart.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter.js
  Cache-Control: no-cache
/assets/*
  Cache-Control: no-cache
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/mcp.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
